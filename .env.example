# APP
APP_ENV=development
APP_NAME=Camell Wash
APP_SHORT_NAME=Camell
LOG_LEVEL=debug

# FRONTEND
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
FRONTEND_PORT=3000

# BACKEND
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
BACKEND_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-a-local-database-password
DB_NAME=proyecto_base_1
DB_SSLMODE=disable
DB_AUTO_MIGRATE=true

# AUTH / SECURITY
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL=12h
SESSION_IDLE_TIMEOUT=30m
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
PASSWORD_BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=15m
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=120
# DEVELOPMENT SEED (never enabled in production)
SEED_DEVELOPMENT=false
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=replace-with-a-development-password
